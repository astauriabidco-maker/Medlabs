# ============================================
# MedLabs Production Environment Variables
# ============================================
# Copy this file to .env.production and fill in the values
# NEVER commit this file to version control!

# ============================================
# Core Settings
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Database
# ============================================
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
DATABASE_URL=postgresql://admin:${DB_PASSWORD}@postgres:5432/medlab_db

# ============================================
# Security
# ============================================
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING_HERE_PLEASE

# ============================================
# CORS (comma-separated allowed origins)
# ============================================
FRONTEND_URL=https://app.medlab.cm,https://medlab.cm

# ============================================
# S3/MinIO Storage
# ============================================
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY_32_CHARS
S3_ENDPOINT=http://minio:9000
S3_BUCKET=medlab-documents

# ============================================
# Monitoring
# ============================================
SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================
# API URL (for frontend)
# ============================================
API_URL=https://api.medlab.cm
