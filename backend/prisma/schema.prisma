// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS (Roles & Status)
// --------------------------------------

enum UserRole {
  SUPER_ADMIN // Platform Owner
  LAB_ADMIN // Client Admin
  TECHNICIAN // Operational Staff
  VIEWER // Front desk / Read-only
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TenantType {
  PRIVATE_LAB
  PUBLIC_HOSPITAL
  CLINIC
  OTHER
}

enum IntegrationProvider {
  TWILIO
  META       // WhatsApp Business API direct
  ORANGE     // Orange SMS Cameroon
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  NOTIFIED // Email/SMS sent
  DELIVERED // SMS received on phone
  OPENED // Patient accessed the doc
  EXPIRED // Deleted by retention policy
  FAILED
}

enum IntegrationStatus {
  SUCCESS
  ERROR
  PENDING_INFO
}
enum AuditAction {
  // Authentication
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  IMPERSONATION_START
  IMPERSONATION_END
  
  // Documents
  UPLOAD_DOCUMENT
  VIEW_DOCUMENT
  DELETE_DOCUMENT
  DOCUMENT_SHARED
  
  // User Management
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_SUSPENDED
  
  // Tenant Management
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_SUSPENDED
  
  // Settings
  UPDATE_SETTINGS
  PLAN_CHANGED
  MODULE_ACTIVATED
  MODULE_DEACTIVATED
  
  // Financial
  PAYMENT_RECEIVED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CANCELLED
  
  // System
  EXPORT_DATA
  API_KEY_GENERATED
  SAMPLE_DATA_GENERATED
}

enum LicenseStatus {
  AVAILABLE
  USED
}

enum PaymentStatus {
  FREE       // No payment required
  UNPAID     // Payment pending
  PAID       // Payment completed
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentProviderType {
  CAMPAY        // Aggregator (MTN + Orange)
  ORANGE_MONEY  // Direct Orange Money CM API
  MTN_MOMO      // Direct MTN MoMo CM API
}

enum WhatsAppNotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppProvider {
  META
  TWILIO
}

enum TenantPlan {
  STARTER     // Free tier - basic features
  PREMIUM     // 49,000 FCFA/month - advanced features
  ENTERPRISE  // 99,000 FCFA/month - all features
}

enum AppointmentType {
  LAB_VISIT       // Consultation au laboratoire
  HOME_SAMPLING   // Prélèvement à domicile
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum AlertSeverity {
  INFO        // Informational
  WARNING     // Needs attention soon
  CRITICAL    // Immediate action required
}

enum AlertType {
  LOW_SMS_BALANCE       // Tenant running low on SMS credits
  INACTIVE_TENANT       // Tenant hasn't had activity in 7+ days
  PAYMENT_OVERDUE       // Subscription payment overdue
  STORAGE_WARNING       // Approaching storage limits
  SECURITY_EVENT        // Login failures, suspicious activity
  SYSTEM_ERROR          // Backend errors, API failures
  NEW_TENANT            // New tenant registration
}

enum SubscriptionStatus {
  TRIAL           // Free trial period
  ACTIVE          // Paid and active
  PAST_DUE        // Payment overdue
  CANCELLED       // User cancelled
  SUSPENDED       // Admin suspended
}

// --------------------------------------
// MODELS
// --------------------------------------

// Tenant Subscription Billing
model Subscription {
  id            String             @id @default(uuid())
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  // Tenant Relation
  tenantId      String             @unique @map("tenant_id")
  tenant        Tenant             @relation(fields: [tenantId], references: [id])

  // Plan Details
  plan          TenantPlan         @default(STARTER)
  status        SubscriptionStatus @default(TRIAL)
  
  // Billing Cycle
  billingCycle  String             @default("MONTHLY") @map("billing_cycle")  // MONTHLY | YEARLY
  pricePerMonth Int                @default(0) @map("price_per_month")        // In XAF
  
  // Dates
  trialEndsAt   DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime      @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime      @default(now()) @map("current_period_end")
  cancelledAt   DateTime?          @map("cancelled_at")
  
  // Payment History
  payments      SubscriptionPayment[]
  
  @@map("subscriptions")
  @@index([status])
}

// Subscription Payment Records
model SubscriptionPayment {
  id            String             @id @default(uuid())
  createdAt     DateTime           @default(now()) @map("created_at")

  // Subscription Relation
  subscriptionId String            @map("subscription_id")
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id])

  // Payment Details
  amount        Int                               // In XAF
  currency      String             @default("XAF")
  provider      PaymentProviderType?
  externalRef   String?            @map("external_ref")
  status        TransactionStatus  @default(PENDING)
  
  // Period Covered
  periodStart   DateTime           @map("period_start")
  periodEnd     DateTime           @map("period_end")
  
  // Notes
  notes         String?
  
  @@map("subscription_payments")
  @@index([subscriptionId])
  @@index([createdAt])
}

// System-wide alerts for Super Admin
model SystemAlert {
  id          String         @id @default(uuid())
  createdAt   DateTime       @default(now()) @map("created_at")
  
  type        AlertType
  severity    AlertSeverity  @default(WARNING)
  title       String
  message     String
  
  // Optional link to tenant/user
  tenantId    String?        @map("tenant_id")
  tenant      Tenant?        @relation("TenantAlerts", fields: [tenantId], references: [id])
  userId      String?        @map("user_id")
  
  // Status
  isRead      Boolean        @default(false) @map("is_read")
  isDismissed Boolean        @default(false) @map("is_dismissed")
  
  // Metadata
  metadata    Json?          // Extra data (e.g., current balance, threshold)
  
  @@map("system_alerts")
  @@index([createdAt])
  @@index([isRead, isDismissed])
}

model Tenant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Identity
  name String
  slug String @unique // for URLs (e.g., app.medlab.cm/slug)

  // Legal & Admin (Cameroon Context)
  structureType    TenantType @default(PRIVATE_LAB) @map("structure_type")
  niu              String? // Numéro Identifiant Unique (Tax)
  rccm             String? // Registre Commerce
  accreditationRef String?    @map("accreditation_ref") // Ministère Santé ID

  // Location
  address String? @db.Text
  city    String?
  gpsLat  Float?  @map("gps_lat")
  gpsLng  Float?  @map("gps_lng")

  // Contacts
  contactEmail String? @map("contact_email") // Technical
  billingEmail String? @map("billing_email") // Financial
  phoneNumber  String? @map("phone_number") // General Lab Phone

  // SMS Configuration
  smsSenderId String @default("MEDRESULT") @map("sms_sender_id") // Max 11 chars
  smsBalance  Int    @default(0) @map("sms_balance")

  // Data Retention (Days to keep files)
  maxRetentionDays        Int @default(30) @map("max_retention_days")        // Limite Super Admin (contrat)
  configuredRetentionDays Int @default(30) @map("configured_retention_days") // Préférence Lab Admin

  // Status
  isActive Boolean @default(true) @map("is_active")
  
  // Subscription Plan
  plan TenantPlan @default(STARTER) @map("plan")

  // Feature Flags & Licensing
  features          String[]  @default(["WHATSAPP_BUSINESS"])  // Base offer includes WhatsApp
  licenseKey        String?   @map("license_key")  // Activation key used
  syncApiKey        String?   @unique @map("sync_api_key")  // API key for Windows automation
  isAutoSyncEnabled Boolean   @default(false) @map("is_auto_sync_enabled")

  // White Labeling / Branding
  brandColor    String? @map("brand_color")     // Hex code, e.g., "#3B82F6"
  brandLogoUrl  String? @map("brand_logo_url")  // Public URL to logo

  // Critical Value Alerts
  biologistPhone String? @map("biologist_phone")  // Phone for critical alerts

  // Mobile Money Integration
  paymentProvider  PaymentProviderType? @map("payment_provider")
  
  // Campay Credentials (Aggregator)
  campayUsername   String? @map("campay_username")  // ENCRYPTED
  campayPassword   String? @map("campay_password")  // ENCRYPTED
  
  // Orange Money CM Credentials (Direct API)
  orangeUsername   String? @map("orange_username")    // ENCRYPTED
  orangePassword   String? @map("orange_password")    // ENCRYPTED
  orangeAuthToken  String? @map("orange_auth_token")  // X-AUTH-TOKEN
  orangeMsisdn     String? @map("orange_msisdn")       // ChannelUserMsisdn
  
  // MTN MoMo CM Credentials (Direct API)
  mtnApiUser          String? @map("mtn_api_user")
  mtnApiKey           String? @map("mtn_api_key")            // ENCRYPTED
  mtnSubscriptionKey  String? @map("mtn_subscription_key")   // Primary key
  mtnTargetEnv        String? @map("mtn_target_env")         // sandbox | production

  // Appointment Booking Settings
  appointmentDuration       Int     @default(15) @map("appointment_duration")  // Minutes per slot
  openingTime               String  @default("07:00") @map("opening_time")
  closingTime               String  @default("15:00") @map("closing_time")
  isHomeSamplingEnabled     Boolean @default(false) @map("is_home_sampling_enabled")
  maxAppointmentsPerSlot    Int     @default(1) @map("max_appointments_per_slot")  // How many patients per slot

  // HL7/LIS Integration Settings
  hl7IntegrationEnabled Boolean @default(false) @map("hl7_integration_enabled")
  pdfTemplateHeader     String? @db.Text @map("pdf_template_header")  // HTML/Base64 for generated PDF header

  // Business Intelligence (Premium Feature)
  statsEnabled Boolean @default(false) @map("stats_enabled")

  // WhatsApp Provider Selection
  whatsappProvider            WhatsAppProvider @default(META) @map("whatsapp_provider")

  // WhatsApp Business Cloud API (Meta) - BYOK
  whatsappPhoneNumberId       String? @map("whatsapp_phone_number_id")
  whatsappAccessToken         String? @map("whatsapp_access_token")       // Long-lived token (ENCRYPTED)
  whatsappBusinessAccountId   String? @map("whatsapp_business_account_id")

  // Twilio WhatsApp (Fallback Provider)
  twilioAccountSid            String? @map("twilio_account_sid")
  twilioAuthToken             String? @map("twilio_auth_token")           // ENCRYPTED
  twilioWhatsappNumber        String? @map("twilio_whatsapp_number")      // Format: whatsapp:+1415...

  // Liste des médecins prescripteurs (pour BI Dashboard)
  prescribers                 String[] @default([])  // Ex: ["Dr. Dupont", "Dr. Martin"]

  // Relations
  users           User[]
  documents       Document[]
  auditLogs       AuditLog[]
  integration     TenantIntegration?
  licenses        License[]
  criticalRules   CriticalRule[]
  transactions    Transaction[]
  appointments    Appointment[]
  blockedSlots    BlockedSlot[]
  integrationLogs IntegrationLog[]
  roles           Role[]
  systemAlerts    SystemAlert[]   @relation("TenantAlerts")
  subscription    Subscription?

  @@map("tenants")
}

// API Integration Configuration (BYOK - Bring Your Own Key)
model TenantIntegration {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Tenant Relation (1-to-1)
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Provider Configuration
  provider    IntegrationProvider @default(TWILIO)
  accountId   String              @map("account_id")  // Twilio SID, Meta App ID, etc.
  authToken   String              @map("auth_token")  // ENCRYPTED - Never store plain text!
  phoneNumber String              @map("phone_number") // Sender number (+237...)

  // Feature Toggles
  smsEnabled      Boolean @default(true) @map("sms_enabled")
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  isActive        Boolean @default(true) @map("is_active")

  // Metadata
  lastTestedAt DateTime? @map("last_tested_at")
  testStatus   String?   @map("test_status") // 'success' | 'failed' | null

  @@map("tenant_integrations")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft Delete

  // Context
  tenantId String? @map("tenant_id") // Null only for SUPER_ADMIN
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Auth
  email        String @unique
  passwordHash String @map("password_hash")

  // Profile
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  role      UserRole @default(VIEWER)  // Legacy enum, kept for SUPER_ADMIN
  lastLoginAt DateTime? @map("last_login_at")

  // Dynamic RBAC
  customRoleId String? @map("custom_role_id")
  customRole   Role?   @relation(fields: [customRoleId], references: [id])

  // Status
  status          UserStatus @default(INVITED)
  invitationToken String? @map("invitation_token") // For initial setup

  // Relations
  uploadedDocs Document[]

  @@index([tenantId])
  @@index([customRoleId])
  @@map("users")
}

// Dynamic Role-Based Access Control
model Role {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Tenant Relation
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Role Definition
  name        String    // "Biologiste", "Secrétaire", etc.
  description String?   @db.Text
  permissions String[]  // Array of permission keys: ["UPLOAD_SCAN", "VIEW_RESULTS"]
  isSystem    Boolean   @default(false) @map("is_system")  // Prevent deletion of Admin role

  // Users with this role
  users User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Document {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Multi-Tenancy
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Metadata
  folderRef String @map("folder_ref") // The ID from the SIL (External)

  // File Storage (S3)
  fileKey  String @map("file_key") // S3 Key/Path
  mimeType String @default("application/pdf") @map("mime_type")
  fileSize Int    @map("file_size") // In Bytes

  // Patient Snapshot (Stored here to preserve history even if patient DB changes)
  patientFirstName String?   @map("patient_first_name")
  patientLastName  String    @map("patient_last_name")
  patientEmail     String    @map("patient_email")
  patientPhone     String    @map("patient_phone") // E.164 Format strictly enforced in code
  patientDob       DateTime? @map("patient_dob") // Optional, for security challenge

  // Security & Lifecycle
  accessKey  String         @unique @default(uuid()) @map("access_key") // The "Magic Link" token
  accessCode String?        @map("access_code") // Short readable code for physical receipt (e.g., "X4-92")
  expiresAt  DateTime       @map("expires_at") // HDS Retention Policy
  status       DocumentStatus @default(UPLOADED)
  isAnonymized Boolean        @default(false) @map("is_anonymized")
  isCritical   Boolean        @default(false) @map("is_critical")  // Flagged by keyword analysis

  // Payment (Paywall)
  price         Float          @default(0)
  paymentStatus PaymentStatus  @default(FREE) @map("payment_status")

  // Traceability
  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  // Business Intelligence
  prescriberName String? @map("prescriber_name")  // Doctor who prescribed the tests

  // WhatsApp Notification Tracking
  whatsappStatus     WhatsAppNotificationStatus? @map("whatsapp_status")
  whatsappMessageId  String?                     @map("whatsapp_message_id")
  whatsappSentAt     DateTime?                   @map("whatsapp_sent_at")

  // Payment Transactions
  transactions Transaction[]

  @@index([tenantId])
  @@index([folderRef])
  @@index([accessKey])
  @@index([accessCode])
  @@index([patientPhone])
  @@map("documents")
}

model OtpStore {
  id             String   @id @default(uuid())
  tokenSignature String   @map("token_signature") // Hashed or signature part of the JWT to verify against
  codeHash       String   @map("code_hash")
  attempts       Int      @default(0)
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tokenSignature])
  @@map("otp_store")
}

// Patient Portal Authentication Sessions
model PatientSession {
  id          String   @id @default(uuid())
  phoneNumber String   @map("phone_number")
  tenantId    String   @map("tenant_id")
  otpHash     String   @map("otp_hash")
  expiresAt   DateTime @map("expires_at")
  verified    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phoneNumber, tenantId])
  @@map("patient_sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Scope
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Event
  action      AuditAction
  description String?
  resourceId  String?     @map("resource_id") // ID of the document or user affected

  // Actor
  actorId   String? @map("actor_id") // Can be User ID or "PATIENT"
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  @@index([tenantId])
  @@map("audit_logs")
}

model SystemConfig {
  key       String   @id
  value     String   @db.Text
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model PartnerRequest {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  laboratoryName  String  @map("laboratory_name")
  contactName     String  @map("contact_name")
  email           String
  phone           String
  city            String
  estimatedVolume String? @map("estimated_volume")
  message         String? @db.Text

  status    String @default("PENDING") // PENDING, CONTACTED, CONVERTED, REJECTED
  notes     String? @db.Text // Internal notes from sales team

  @@map("partner_requests")
}

// License Management for Feature Activation
model License {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  
  code      String        @unique  // Format: AUTO-XXXX-XXXX
  feature   String                 // e.g., "AUTO_SYNC"
  status    LicenseStatus @default(AVAILABLE)
  
  // Tracking
  generatedBy    String  @map("generated_by")  // Admin user ID who generated
  usedByTenantId String? @map("used_by_tenant_id")
  usedByTenant   Tenant? @relation(fields: [usedByTenantId], references: [id])
  usedAt         DateTime? @map("used_at")
  
  @@map("licenses")
}

// Critical Value Alert Rules
model CriticalRule {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Tenant Relation
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Rule Configuration
  name           String
  keywords       String[]           // e.g., ["VIH", "Positif"]
  mustContainAll Boolean @default(true) @map("must_contain_all")
  alertMessage   String  @map("alert_message") @db.Text
  isActive       Boolean @default(true) @map("is_active")

  @@index([tenantId, isActive])
  @@map("critical_rules")
}

// Mobile Money Payment Transactions
model Transaction {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  // Tenant Relation
  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])

  // Document Relation
  documentId   String            @map("document_id")
  document     Document          @relation(fields: [documentId], references: [id])

  // Transaction Details
  amount       Float
  currency     String            @default("XAF")  // CFA Franc
  provider     String            // 'MOMO' | 'OM'
  externalRef  String?           @map("external_ref")  // Campay reference
  phoneNumber  String            @map("phone_number")  // Payer phone
  status       TransactionStatus @default(PENDING)

  @@index([tenantId])
  @@index([documentId])
  @@index([externalRef])
  @@map("transactions")
}

// Appointment Booking
model Appointment {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Tenant Relation
  tenantId    String            @map("tenant_id")
  tenant      Tenant            @relation(fields: [tenantId], references: [id])

  // Appointment Details
  patientName  String           @map("patient_name")
  patientPhone String           @map("patient_phone")
  patientEmail String?          @map("patient_email")  // Optional for email confirmations
  type         AppointmentType
  date         DateTime         // Scheduled slot datetime
  address      String?          @db.Text  // Required for HOME_SAMPLING
  notes        String?          @db.Text  // "A jeun", "Diabétique", etc.
  status       AppointmentStatus @default(PENDING)

  // Reminder tracking
  reminderDayBeforeSent   DateTime? @map("reminder_day_before_sent")
  reminderHoursBeforeSent DateTime? @map("reminder_hours_before_sent")

  // History / audit trail
  history  AppointmentHistory[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("appointments")
}

// Blocked slots for closures, holidays, etc.
model BlockedSlot {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  date      DateTime // The date that is blocked
  allDay    Boolean  @default(true) @map("all_day") // If false, use startTime/endTime
  startTime String?  @map("start_time") // e.g. "08:00"
  endTime   String?  @map("end_time")   // e.g. "12:00"
  reason    String?  // e.g. "Congés", "Jour férié", "Formation"

  @@index([tenantId, date])
  @@map("blocked_slots")
}

// Appointment modification history / audit trail
model AppointmentHistory {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  action        String      // CREATED, STATUS_CHANGED, UPDATED, CANCELLED
  oldStatus     String?     @map("old_status")
  newStatus     String?     @map("new_status")
  changedBy     String?     @map("changed_by")  // User ID or "SYSTEM" or "PATIENT"
  changedByName String?     @map("changed_by_name")  // Human-readable name
  details       String?     @db.Text  // JSON or text description of changes
  ipAddress     String?     @map("ip_address")

  @@index([appointmentId])
  @@map("appointment_history")
}

// Integration API Logs (for LIS/HL7 ingestion tracking)
model IntegrationLog {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now()) @map("created_at")

  tenantId     String            @map("tenant_id")
  tenant       Tenant            @relation(fields: [tenantId], references: [id])

  format       String            // "JSON" | "HL7"
  payload      String            @db.Text  // Raw data received
  status       IntegrationStatus
  errorMessage String?           @db.Text @map("error_message")
  documentId   String?           @map("document_id")  // Created document (if successful)
  patientPhone String?           @map("patient_phone")  // Extracted phone

  @@index([tenantId, createdAt])
  @@map("integration_logs")
}

// --------------------------------------
// PRICING MANAGEMENT (Super Admin)
// --------------------------------------

model PricingPlan {
  id           String   @id @default(cuid())
  name         String   // "Starter", "Premium", "Enterprise"
  slug         String   @unique
  description  String?
  price        Int      @default(0) // en FCFA, 0 = gratuit
  interval     String   @default("month") // "month" | "year"
  popular      Boolean  @default(false) // "Le plus populaire" badge
  color        String   @default("blue") // theme color
  buttonText   String?  @map("button_text")
  buttonVariant String  @default("default") @map("button_variant")
  sortOrder    Int      @default(0) @map("sort_order")
  active       Boolean  @default(true)
  
  includedFeatures String[] @default([]) // feature keys included
  featureLimits    Json?    @map("feature_limits") // {"TEAM_MEMBERS": 3, "RETENTION_DAYS": 90}
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  
  @@map("pricing_plans")
}

model PricingFeature {
  id          String   @id @default(cuid())
  name        String   // Display name: "Membres d'équipe"
  key         String   @unique // Identifier: "TEAM_MEMBERS"
  description String?
  category    String?  // "communication", "storage", "analytics", "integration"
  icon        String?  // lucide icon name: "Users", "Database"
  
  // Add-on module settings
  isAddon     Boolean  @default(false) @map("is_addon") // true = module à la carte
  addonPrice  Int?     @map("addon_price") // prix si module séparé
  addonColor  String?  @map("addon_color") // gradient color
  
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("pricing_features")
}

// --------------------------------------
// OCR CONFIGURATION
// Configurable exclusion keywords for patient name detection
// --------------------------------------

model OcrExclusionKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique  // e.g., "biologiste", "major"
  category  String   @default("role") // "role" | "title" | "context"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("ocr_exclusion_keywords")
}
